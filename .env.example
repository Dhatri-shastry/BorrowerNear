APP_NAME=BorrowNear API
APP_ENV=development
API_V1_PREFIX=/api/v1
DATABASE_HOST=localhost
DATABASE_PORT=3306
DATABASE_NAME=borrownear
DATABASE_USER=borrownear_app
DATABASE_PASSWORD=replace_locally
DB_POOL_SIZE=5
JWT_SECRET=replace_with_a_random_secret_of_at_least_32_characters
JWT_ALGORITHM=HS256
ACCESS_TOKEN_MINUTES=60
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
REDIS_URL=redis://localhost:6379/0
CACHE_TTL_SECONDS=60
MYSQL_ROOT_PASSWORD=replace_with_a_local_root_password_for_docker_only
MYSQL_PUBLISHED_PORT=3307
REDIS_PUBLISHED_PORT=6379
