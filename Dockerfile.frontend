FROM node:24-alpine AS dependencies
WORKDIR /web
COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci

FROM node:24-alpine AS builder
WORKDIR /web
ARG API_PROXY_URL=http://127.0.0.1:8000/api/v1
ENV API_PROXY_URL=$API_PROXY_URL
COPY --from=dependencies /web/node_modules ./node_modules
COPY frontend ./
RUN mkdir -p public
RUN npm run build

FROM node:24-alpine AS runner
ENV NODE_ENV=production HOSTNAME=0.0.0.0 PORT=3000
WORKDIR /web
RUN addgroup --system --gid 1001 nodejs \
    && adduser --system --uid 1001 nextjs
COPY --from=builder --chown=nextjs:nodejs /web/public ./public
COPY --from=builder --chown=nextjs:nodejs /web/.next ./.next
COPY --from=builder --chown=nextjs:nodejs /web/node_modules ./node_modules
COPY --from=builder --chown=nextjs:nodejs /web/package.json ./package.json
USER nextjs
EXPOSE 3000
CMD ["npm", "run", "start"]
